FINANCE_ENVIRONMENT=development
FINANCE_LOG_LEVEL=INFO
FINANCE_DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
FINANCE_DATABASE_ECHO=false
FINANCE_IMPORT_STORAGE_ROOT=/tmp/finance-aggregator/imports
FINANCE_IMPORT_MAX_FILE_SIZE_BYTES=26214400
FINANCE_IMPORT_XML_MAX_DEPTH=64
FINANCE_IMPORT_XML_MAX_ELEMENTS=100000
FINANCE_IMPORT_XML_MAX_VALUE_LENGTH=65536
FINANCE_WORKER_POLL_INTERVAL_SECONDS=1
FINANCE_FX_HTTP_TIMEOUT_SECONDS=5
FINANCE_FX_MAX_ATTEMPTS=3
FINANCE_FX_RETRY_BACKOFF_SECONDS=0.25
FINANCE_FX_RESPONSE_MAX_BYTES=524288
FINANCE_FX_MIN_SYNC_INTERVAL_SECONDS=60
FINANCE_FX_STALE_AFTER_SECONDS=259200
FINANCE_MARKET_PRICE_STALE_AFTER_SECONDS=259200
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173
